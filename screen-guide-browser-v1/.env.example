# Screen Guide — environment configuration.
# Copy to .env (gitignored) for local builds; set the same vars in Vercel for prod.
# build.cjs reads GUIDE_PROXY_URL / GUIDE_SHARED_SECRET / ANTHROPIC_API_KEY to
# write dist/config.json. The proxy (api/analyze.js) reads the rest at runtime.

# ── Extension build (dist/config.json) ─────────────────────────────────────────
# PRODUCTION: point the extension at the proxy; the API key stays server-side.
GUIDE_PROXY_URL=https://your-app.vercel.app/api/analyze
GUIDE_SHARED_SECRET=replace-with-a-long-random-string

# DEV ONLY: bake the Anthropic key into the extension to call Claude directly.
# Leave unset in production. (If GUIDE_PROXY_URL is set, this is ignored.)
# ANTHROPIC_API_KEY=sk-ant-...

# ── Proxy runtime (Vercel project env — NOT shipped in the extension) ───────────
# ANTHROPIC_API_KEY=sk-ant-...            # the real key, server-side only
# GUIDE_SHARED_SECRET=...                 # must match the value built into the extension

# CORS allow-list (comma-separated). chrome-extension:// origins are always allowed;
# add your dashboard origins here once the Briolo web app calls the proxy.
# GUIDE_ALLOWED_ORIGINS=https://briolo.io,https://app.briolo.io

# Global daily request ceiling (circuit breaker). Caps worst-case spend even if the
# shared secret leaks. Defaults to 5000/day if unset.
# GUIDE_MAX_DAILY=5000

# Durable rate limiting across serverless instances (recommended for production).
# Without these, rate limiting is best-effort in-memory (per warm instance only).
# Create a free Upstash Redis DB and paste its REST URL + token.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# ── Workshop capture UX (spec 2026-07-02) ───────────────────────────────────────
# Brand shown in the panel header (e.g. "Robot Roadmap" for workshop cohorts).
# GUIDE_BRAND=Robot Roadmap

# Dashboard the finish-line hands tokens into. The panel deep-links to
# <dashboardUrl>/<flow.deepLink> and polls <dashboardUrl>/api/<flow.deepLink>/status
# after the owner attests the paste. Leave unset until the dashboard exists —
# the panel then shows an honest pass-through instead of a fake green tick.
# GUIDE_DASHBOARD_URL=https://app.example.com

# Who "will come to you" in flag mode. Defaults to "Your facilitator".
# GUIDE_FACILITATOR_NAME=James
